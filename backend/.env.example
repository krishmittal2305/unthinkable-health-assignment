# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_appointments"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Azure OpenAI (pre-visit / post-visit LLM summaries)
AZURE_OPENAI_ENDPOINT="https://<your-resource-name>.openai.azure.com"
AZURE_OPENAI_API_KEY="replace-with-azure-openai-key"
AZURE_OPENAI_DEPLOYMENT="replace-with-deployment-name"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# Email (Nodemailer over Gmail/SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-clinic-account@gmail.com"
SMTP_PASS="replace-with-gmail-app-password"
EMAIL_FROM="Clinic <your-clinic-account@gmail.com>"

# Google Calendar OAuth 2.0 — see docs/google-calendar-setup.md
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/doctor/calendar/callback"

# Frontend origin (CORS)
FRONTEND_URL="http://localhost:5173"

# Seed script (backend/prisma/seed.js) — optional, these are the defaults if omitted
SEED_ADMIN_EMAIL="admin@clinic.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"
